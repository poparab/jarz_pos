   "fieldname": "week_interval",
   "fieldtype": "Int",
   "label": "Every N Weeks"
  },
  {
   "depends_on": "eval:doc.cycle=='Days of Month'",
   "description": "Comma list of 1-31 and/or 'last' (e.g. 15,last). A day past the month's length means its last day.",
   "fieldname": "month_days",
   "fieldtype": "Small Text",
   "label": "Days of Month"
